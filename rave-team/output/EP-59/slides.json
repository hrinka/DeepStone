    {"type": "body", "text": ["Manchester. Moss Side.", "His father's blue beat and reggae records.", "His mother's Pentecostal church.", "Sound systems on the street outside.", "This is what he grew up inside of."], "sub": "Three sounds, one childhood."},
    {"type": "body", "text": ["1988. Moonraker Studios.", "Two days of recording.", "A vocal sample is meant to say", "\"Voodoo Rage.\"", "The tape gets cut short", "by mistake."], "sub": "A mistake on a two-day session."},
    {"type": "body", "text": ["It comes out as \"Voodoo Ray.\"", "500 copies. Gone in a day.", "18 weeks on the chart.", "The Haçienda plays it", "until the floor remembers it", "by heart."], "sub": "A typo the dancefloor never forgot."},
    {"type": "body", "text": ["He's also building a track", "with 808 State.", "\"Pacific State.\"", "He leaves before it's finished.", "They finish it without him.", "He fights for the credit.", "Money runs out."], "sub": "A credit he had to fight for."},
