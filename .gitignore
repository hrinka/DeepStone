# シークレット
.env
*.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Claude worktrees（一時作業領域）
.claude/worktrees/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/

# ログ・キャッシュ
*.log
.cache/

# 画像（ローカルのみ・GitHub には上げない）
_attachments/

# カルーセル表紙の個人写真（ローカルのみ・流出防止）
**/cover*.jpg
**/cover*.jpeg
**/cover*.png
**/IMG_*.jpg
**/IMG_*.jpeg
**/IMG_*.png
**/IMG_*.HEIC
**/IMG_*.heic
**/bg-*.jpg
**/bg-*.jpeg
**/bg-*.png
**/slide_[1-9].jpg
**/slide_[1-9].jpeg
**/slide_[1-9].png

# レンダー済みスライドPNG（slides.jsonから再生成可・写真が焼き込まれるため公開しない）
**/slides/slide_*.png

# スライド背景素材（EPフォルダ/slides/）はリモートで自動編集するため共有可
# EP10-1.png 等の命名 → レンダー済み slide_*.png とは別管理
!rave-team/output/**/slides/EP*.png
!rave-team/output/**/slides/EP*.jpg
!rave-team/output/**/slides/EP*.jpeg

# 投稿フォルダ内の画像は全てローカル限定（素材・背景・完成スライド／著作物保護）
rave-team/output/**/*.png
rave-team/output/**/*.jpg
rave-team/output/**/*.jpeg
flava-fm/output/**/*.png
flava-fm/output/**/*.jpg
flava-fm/output/**/*.jpeg
aroma-insta/output/**/*.png
aroma-insta/output/**/*.jpg
aroma-insta/output/**/*.jpeg

